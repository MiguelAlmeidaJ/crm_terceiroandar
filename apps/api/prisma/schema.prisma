generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemEvent {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_events")
}

enum Role {
  SYSTEM
  ADMIN
  GESTOR
  COLABORADOR
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  sessionVersion Int @default(0) @map("session_version")
  tenantId       String? @map("tenant_id")
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role         Role     @default(COLABORADOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  auditActions AuditLog[] @relation("AuditActor")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  authoredActivities OpportunityActivity[] @relation("ActivityAuthor")
  contactInteractions ContactInteraction[]
  assignedTasks CommercialTask[] @relation("TaskAssignee")
  createdTasks CommercialTask[] @relation("TaskCreator")

  @@index([tenantId, role])
  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  actor       User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action      String
  targetId    String   @map("target_id")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
  tenantId String @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

enum OpportunityStage {
  NOVO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

model Contact {
  id            String        @id @default(uuid())
  name          String
  email         String?
  phone         String?
  company       String?
  notes         String?
  source        String?
  jobTitle      String?        @map("job_title")
  website       String?
  tags          String[]       @default([])
  interactions  ContactInteraction[]
  campaignMemberships MarketingCampaignContact[]
  leadCaptures MarketingLeadCapture[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  opportunities Opportunity[]

  @@index([name])
  @@map("contacts")
  tenantId String @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model Opportunity {
  id           String           @id @default(uuid())
  title        String
  description  String?
  value        Decimal?         @db.Decimal(14,2)
  stage        OpportunityStage @default(NOVO)
  contactId    String           @map("contact_id")
  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  ownerId      String?          @map("owner_id")
  owner        User?            @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  expectedAt   DateTime?        @map("expected_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  activities   OpportunityActivity[]
  tasks        CommercialTask[]
  campaignId String? @map("campaign_id")
  campaign MarketingCampaign? @relation(fields:[campaignId],references:[id],onDelete:SetNull)

  @@index([tenantId,campaignId])
  @@index([stage])
  @@index([contactId])
  @@index([ownerId])
  @@map("opportunities")
  tenantId String @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model OpportunityActivity {
  id             String      @id @default(uuid())
  opportunityId  String      @map("opportunity_id")
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  authorId       String      @map("author_id")
  author         User        @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  message        String
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([opportunityId, createdAt])
  @@map("opportunity_activities")
  tenantId String @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

model CommercialTask {
  id            String          @id @default(uuid())
  title         String
  description   String?
  status        TaskStatus      @default(PENDENTE)
  priority      TaskPriority    @default(MEDIA)
  dueDate       DateTime        @db.Date @map("due_date")
  completedAt   DateTime?       @map("completed_at")
  opportunityId String          @map("opportunity_id")
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  assigneeId    String          @map("assignee_id")
  assignee      User            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creatorId     String          @map("creator_id")
  creator       User            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([assigneeId, status, dueDate])
  @@index([opportunityId])
  @@index([status, dueDate])
  @@map("commercial_tasks")
  tenantId String @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model Tenant {
  id String @id @default(uuid())
  name String
  slug String @unique
  active Boolean @default(true)
  isLegacy Boolean @default(false) @map("is_legacy")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users User[]
  contacts Contact[]
  marketingCampaigns MarketingCampaign[]
  marketingCampaignContacts MarketingCampaignContact[]
  marketingLeadCaptures MarketingLeadCapture[]
  contactInteractions ContactInteraction[]
  opportunities Opportunity[]
  activities OpportunityActivity[]
  tasks CommercialTask[]
  auditLogs AuditLog[]
  @@map("tenants")
}

enum ContactChannel {
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  NOTA
}

model ContactInteraction {
  id String @id @default(uuid())
  contactId String @map("contact_id")
  contact Contact @relation(fields:[contactId],references:[id],onDelete:Restrict)
  tenantId String @map("tenant_id")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  authorId String @map("author_id")
  author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
  channel ContactChannel
  description String
  occurredAt DateTime @map("occurred_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId,contactId,occurredAt])
  @@map("contact_interactions")
}

enum MarketingCampaignStatus {
  RASCUNHO
  PLANEJADA
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum MarketingChannel {
  INSTAGRAM
  FACEBOOK
  GOOGLE_ADS
  EMAIL
  WHATSAPP
  SITE
  EVENTO
  INDICACAO
  OUTRO
}

model MarketingCampaign {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  name String
  description String?
  channel MarketingChannel
  status MarketingCampaignStatus @default(RASCUNHO)
  budget Decimal? @db.Decimal(14,2)
  spent Decimal @default(0) @db.Decimal(14,2)
  startDate DateTime? @db.Date @map("start_date")
  endDate DateTime? @db.Date @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  contacts MarketingCampaignContact[]
  opportunities Opportunity[]
  captureToken String @unique @default(uuid()) @map("capture_token")
  captureEnabled Boolean @default(false) @map("capture_enabled")
  leadCaptures MarketingLeadCapture[]

  @@index([tenantId,status])
  @@index([tenantId,channel])
  @@map("marketing_campaigns")
}

model MarketingCampaignContact {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  campaignId String @map("campaign_id")
  campaign MarketingCampaign @relation(fields:[campaignId],references:[id],onDelete:Restrict)
  contactId String @map("contact_id")
  contact Contact @relation(fields:[contactId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([campaignId,contactId])
  @@index([tenantId,campaignId])
  @@index([tenantId,contactId])
  @@map("marketing_campaign_contacts")
}

model MarketingLeadCapture {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  campaignId String @map("campaign_id")
  campaign MarketingCampaign @relation(fields:[campaignId],references:[id],onDelete:Restrict)
  contactId String @map("contact_id")
  contact Contact @relation(fields:[contactId],references:[id],onDelete:Restrict)
  utmSource String? @map("utm_source")
  utmMedium String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent String? @map("utm_content")
  utmTerm String? @map("utm_term")
  consentAt DateTime @map("consent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([campaignId,contactId])
  @@index([tenantId,createdAt])
  @@index([tenantId,campaignId])
  @@map("marketing_lead_captures")
}
