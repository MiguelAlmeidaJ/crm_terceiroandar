generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemEvent {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_events")
}

enum Role {
  ADMIN
  GESTOR
  COLABORADOR
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(COLABORADOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  auditActions AuditLog[] @relation("AuditActor")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  authoredActivities OpportunityActivity[] @relation("ActivityAuthor")
  assignedTasks CommercialTask[] @relation("TaskAssignee")
  createdTasks CommercialTask[] @relation("TaskCreator")

  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  actor       User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action      String
  targetId    String   @map("target_id")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

enum OpportunityStage {
  NOVO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

model Contact {
  id            String        @id @default(uuid())
  name          String
  email         String?
  phone         String?
  company       String?
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  opportunities Opportunity[]

  @@index([name])
  @@map("contacts")
}

model Opportunity {
  id           String           @id @default(uuid())
  title        String
  description  String?
  value        Decimal?         @db.Decimal(14,2)
  stage        OpportunityStage @default(NOVO)
  contactId    String           @map("contact_id")
  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  ownerId      String?          @map("owner_id")
  owner        User?            @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  expectedAt   DateTime?        @map("expected_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  activities   OpportunityActivity[]
  tasks        CommercialTask[]

  @@index([stage])
  @@index([contactId])
  @@index([ownerId])
  @@map("opportunities")
}

model OpportunityActivity {
  id             String      @id @default(uuid())
  opportunityId  String      @map("opportunity_id")
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  authorId       String      @map("author_id")
  author         User        @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  message        String
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([opportunityId, createdAt])
  @@map("opportunity_activities")
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

model CommercialTask {
  id            String          @id @default(uuid())
  title         String
  description   String?
  status        TaskStatus      @default(PENDENTE)
  priority      TaskPriority    @default(MEDIA)
  dueDate       DateTime        @db.Date @map("due_date")
  completedAt   DateTime?       @map("completed_at")
  opportunityId String          @map("opportunity_id")
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  assigneeId    String          @map("assignee_id")
  assignee      User            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creatorId     String          @map("creator_id")
  creator       User            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([assigneeId, status, dueDate])
  @@index([opportunityId])
  @@index([status, dueDate])
  @@map("commercial_tasks")
}
