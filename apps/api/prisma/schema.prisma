generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo inicial para validar a infraestrutura.
// Entidades de negócio serão adicionadas quando o mapa funcional for aplicado.
model SystemEvent {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_events")
}
